<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kmr_iiwa">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import kmr_iiwa urdf file -->
    <xacro:include filename="$(find kmr_iiwa_urdf)/urdf/kmr_iiwa.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="kmr_iiwa.ros2_control.xacro" />


    <xacro:kmr_iiwa_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
