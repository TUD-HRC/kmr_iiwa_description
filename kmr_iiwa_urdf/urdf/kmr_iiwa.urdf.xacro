<?xml version="1.0"?>
<robot name="kmr_iiwa" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find kmr_iiwa_urdf)/urdf/kmr_iiwa_macro.urdf.xacro"/>

  <xacro:arg name="robot_name" default="kmr_iiwa" />
      
  <xacro:kuka_kmr_iiwa robot_name="$(arg robot_name)"/>

</robot>
