<sdf version="1.8">
<world name="sandbox">

    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
        filename="ignition-gazebo-physics-system"
        name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
        filename="ignition-gazebo-scene-broadcaster-system"
        name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
    </plugin>
    <plugin
        filename="libignition-gazebo-magnetometer-system"
        name="ignition::gazebo::systems::Magnetometer">
    </plugin>
    <plugin
        filename="libignition-gazebo-forcetorque-system"
        name="ignition::gazebo::systems::ForceTorque">
    </plugin>
    <!-- Necessary for spawining robot even from the launch-->
    <plugin
        filename="libignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
        <static>true</static>
        <link name="link">
        <collision name="collision">
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
            </plane>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
            </plane>
            </geometry>
            <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            </material>
        </visual>
        </link>
    </model>

    <!-- ========================= -->
    <!-- SANDBOX WALLS (BOUNDARY) -->
    <!-- ========================= -->

<model name="north">
  <static>true</static>
  <pose>0 10 1.25 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>20 0.2 2.5</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>20 0.2 2.5</size>
        </box>
      </geometry>
    </visual>
  </link>
</model>

<model name="south">
  <static>true</static>
  <pose>0 -10 1.25 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>20 0.2 2.5</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>20 0.2 2.5</size>
        </box>
      </geometry>
    </visual>
  </link>
</model>

<model name="east">
  <static>true</static>
  <pose>10 0 1.25 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 20 2.5</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 20 2.5</size>
        </box>
      </geometry>
    </visual>
  </link>
</model>

<model name="west">
  <static>true</static>
  <pose>-10 0 1.25 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 20 2.5</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 20 2.5</size>
        </box>
      </geometry>
    </visual>
  </link>
</model>


</world>
</sdf>